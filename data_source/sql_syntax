    {
        {
            "Data.pizza_size",
            each
                if _ = "S" then "Regular"
                else if _ = "M" then "Medium"
                else if _ = "L" then "Large"
                else if _ = "XL" then "Extra Large"
                else if _ = "XXL" then "Double Extra Large"
                else _,
            type text
        }
    }
)
